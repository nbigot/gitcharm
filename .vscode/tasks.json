{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "install",
      "label": "Install dependencies",
      "problemMatcher": []
    },
    {
      "type": "npm",
      "script": "build",
      "label": "Build GitCharm",
      "group": "build",
      "problemMatcher": {
        "owner": "esbuild",
        "source": "esbuild",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": [
          { "regexp": "^[✘▲] \\[([A-Z]+)\\] (.+)$", "severity": 1, "message": 2 },
          { "regexp": "^(?:\\t| {4})(?!\\s)([^:]+)(?::([0-9]+))?(?::([0-9]+))?:$", "file": 1, "line": 2, "column": 3 }
        ]
      }
    },
    {
      "type": "npm",
      "script": "package",
      "label": "Build GitCharm (.vsix)",
      "group": "build",
      "problemMatcher": "$tsc"
    }
  ]
}
